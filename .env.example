# SupplyGraph Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets
# See docs/deployment.md for setup instructions

# ============================================================
# GITHUB
# ============================================================
# Personal Access Token for GitHub API (read-only scopes sufficient)
# Required scopes: public_repo, read:user
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# ============================================================
# GOOGLE GEMINI
# ============================================================
# Gemini API key from https://aistudio.google.com
# Used for: AI explanation layer only. Cannot invent evidence.
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# SUPABASE
# ============================================================
# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (can be used server-side for standard operations)
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (BACKEND ONLY - never expose to frontend or client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# BACKEND
# ============================================================
# Public URL of this backend (for CORS and self-reference)
BACKEND_URL=http://localhost:8000

# Allowed CORS origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ============================================================
# FRONTEND (Next.js)
# These NEXT_PUBLIC_ variables are safe to expose to the browser
# ============================================================
# Backend API URL as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# ANALYSIS CONFIGURATION
# ============================================================
# Directory for OSV persistent cache
OSV_CACHE_DIR=.cache/osv

# Maximum repository size in MB to accept for analysis
MAX_REPO_SIZE_MB=100

# Maximum number of files to include in analysis per scan
MAX_FILES_PER_SCAN=1000

# Maximum file size in KB for AST analysis
MAX_FILE_SIZE_KB=500

# Total analysis timeout in seconds
ANALYSIS_TIMEOUT_SECONDS=300

# Maximum transitive dependency depth to traverse
MAX_TRANSITIVE_DEPTH=10

# ============================================================
# CONFIDENCE ENGINE (heuristic weights - configurable)
# ============================================================
# Discount applied to synthetic/simulated evidence (0.0 to 1.0)
SYNTHETIC_DISCOUNT=0.15

# ============================================================
# BLAST RADIUS WEIGHTS (configurable)
# ============================================================
BLAST_RADIUS_PACKAGE_WEIGHT=2
BLAST_RADIUS_SERVICE_WEIGHT=15
BLAST_RADIUS_API_WEIGHT=25
BLAST_RADIUS_DEPLOYMENT_WEIGHT=50

# ============================================================
# GRAPH LAYOUT (pixels - configurable)
# ============================================================
GRAPH_HORIZONTAL_SPACING=280
GRAPH_VERTICAL_SPACING=120
